# --- supabase (project settings -> api) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # the anon key works too

# --- who is allowed in ---------------------------------------------------
# the one email address that can sign in. anyone else is turned away
# before a magic link is ever sent.
OWNER_EMAIL=you@example.com

# --- server-only (never prefix these with NEXT_PUBLIC_) ------------------
# needed by `npm run seed` and the assistant api (/api/tasks). the app
# itself runs on the publishable key + row-level security and does not
# need this to render.
SUPABASE_SERVICE_ROLE_KEY=
# long random string your assistants send as `Authorization: Bearer ...`
# generate one with: openssl rand -hex 32
TASKS_API_TOKEN=
